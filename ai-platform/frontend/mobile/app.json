{
  "expo": {
    "name": "Fixmeapp Business",
    "slug": "fixmeapp-provider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fixmeapp",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#131312",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#131312"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.fixmeapp.provider",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Used for fast and secure login",
        "NSCameraUsageDescription": "Used for profile photos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#131312"
      },
      "package": "ai.fixmeapp.provider",
      "permissions": [
        "NOTIFICATIONS",
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#C8A97E",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#131312",
          "image": "./assets/splash.png"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID"
      }
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
