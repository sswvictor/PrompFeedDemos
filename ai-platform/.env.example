# Database (PostgreSQL required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fixmeapp

# Instagram / Meta
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=fixmeapp_verify_secret
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=http://127.0.0.1:8002/api/v1/instagram/connect/callback
INSTAGRAM_OAUTH_SCOPES=pages_show_list,pages_manage_metadata,instagram_basic,instagram_manage_messages
INSTAGRAM_OAUTH_STATE_SECRET=

# Official IG relay Page id (same as Meta webhook recipient.id). Upserts on each startup when set.
PLATFORM_INSTAGRAM_PAGE_ID=
PLATFORM_INSTAGRAM_PAGE_NAME=fixmeapp
# Optional; if empty, INSTAGRAM_PAGE_ACCESS_TOKEN is stored on this row when upserting.
PLATFORM_INSTAGRAM_PAGE_ACCESS_TOKEN=

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Google Calendar
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Auth - must match JWT_SECRET in the auth backend
JWT_SECRET=supersecret
JWT_ALGORITHM=HS256

# General
DEFAULT_TIMEZONE=Europe/Stockholm

# Web Booking Flow - URL for the booking SPA (sent as a link in Instagram DMs)
WEB_BOOKING_BASE_URL=https://book.fixmeapp.ai

# Stripe - subscription billing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# Referral credits
REFERRAL_CREDIT_SEK=50
REFERRAL_PAYOUT_DAY=1
REFERRAL_AUTO_PAYOUT_ENABLED=true
REFERRAL_AUTO_APPLY_TO_SUBSCRIPTION=true
REFERRAL_AUTO_MARK_PAID=false

# Token encryption
TOKEN_ENCRYPTION_KEY=
